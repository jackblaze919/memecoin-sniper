# Database
DATABASE_URL=postgresql://user:password@localhost:5432/memecoin_sniper

# Solana
HELIUS_API_KEY=
BIRDEYE_API_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_PRIVATE_KEY=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
REPORT_EMAIL=

# Trading
TRADING_MODE=scanner
DRY_RUN=true

# Limits
MAX_TRADES_PER_HOUR=5
MAX_POSITION_SOL=0.05
MAX_CONCURRENT_POSITIONS=3
DAILY_LOSS_LIMIT_SOL=0.1
SOL_RESERVE=0.05
STOP_LOSS_PCT=30

# Scanner
MIN_LIQUIDITY_USD=25000
MIN_HOLDER_COUNT=100
MIN_TOKEN_AGE_MINUTES=15
MAX_TOKEN_AGE_HOURS=24
BUY_SCORE_THRESHOLD=70
MAX_ACTIVE_CANDIDATES=50

# Server
PORT=3000
NODE_ENV=production
